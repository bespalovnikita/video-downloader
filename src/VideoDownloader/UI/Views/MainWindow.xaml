<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VideoDownloader.Native;assembly=VideoDownloader"
    x:Name="MainWindow"
    Title="Video Downloader"
    Width="1500"
    Height="900"
    MinWidth="800"
    MinHeight="550"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource WindowTextBrush}"
    FontFamily="Segoe UI"
    AllowDrop="True">

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <local:WindowThemeResources/>
        </ResourceDictionary.MergedDictionaries>
        <local:DisplayValueConverter x:Key="DisplayValueConverter"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                            BorderBrush="Transparent" BorderThickness="2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Opacity" Value="0.8"/></Trigger>
                            <DataTrigger Binding="{Binding HighContrast, Source={StaticResource WindowThemeState}}" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="1"/>
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HighContrast, Source={StaticResource WindowThemeState}}" Value="True"/>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GuardedActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HighContrast, Source={StaticResource WindowThemeState}}" Value="True"/>
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource FieldHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                x:Name="ToggleButton"
                                Focusable="False"
                                ClickMode="Press"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="ComboChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                            <Grid>
                                                <Path
                                                    Width="8"
                                                    Height="5"
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Fill="{DynamicResource SecondaryTextBrush}"
                                                    Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboChrome" Property="Background" Value="{DynamicResource FieldHoverBrush}"/>
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter
                                x:Name="ContentSite"
                                Margin="9,4,30,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <TextBox
                                x:Name="PART_EditableTextBox"
                                Margin="8,3,30,3"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="{TemplateBinding Foreground}"
                                CaretBrush="{DynamicResource WindowTextBrush}"
                                BorderThickness="0"
                                Padding="0"
                                Visibility="Hidden"
                                Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                PopupAnimation="Fade">
                                <Border
                                    MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                    MaxHeight="300"
                                    Margin="0,3,0,0"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource PopupBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <ScrollViewer
                                        Margin="1"
                                        CanContentScroll="True"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Margin" Value="3,5"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AlternateRowBrush}"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HighContrast, Source={StaticResource WindowThemeState}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TransferDetailTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TransferTextBrush}"/>
        </Style>

        <Style x:Key="VideoLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
      <Setter Property="Text" Value="{Binding DisplayUrl}"/>
      <Setter Property="ToolTip" Value="{Binding DisplayUrl}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True">
                    <Setter Property="Text" Value="{Binding Title}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Title, FallbackValue=''}" Value="">
          <Setter Property="Text" Value="{Binding DisplayUrl}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
          <Setter Property="Text" Value="{Binding DisplayUrl}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Status colors follow stable Status rather than transient text/percent. -->
        <Style x:Key="QueueStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="ToolTip" Value="{Binding StateToolTip}"/>
            <Setter Property="Foreground" Value="{DynamicResource ActiveStateBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource CompletedStateBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Queued">
                    <Setter Property="Foreground" Value="{DynamicResource QueuedStateBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Foreground" Value="{DynamicResource ActiveStateBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Interrupted">
                    <Setter Property="Foreground" Value="{DynamicResource InterruptedStateBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter Property="Foreground" Value="{DynamicResource SkippedStateBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource FailedStateBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HighContrast, Source={StaticResource WindowThemeState}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DownloadStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QueueStatusTextStyle}"/>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource FieldHoverBrush}"/><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource TabIndicatorBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryVideoUrlStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="Text" Value="{Binding DisplayUrl}"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="ToolTip" Value="{Binding DisplayUrl}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Title}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Title}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>
        <DataTemplate x:Key="TransferDetails">
            <StackPanel x:Name="TransferDetailsPanel" Margin="0,3,0,3">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <!-- A fresh waiting row has no transfer to report.
                                 Retained attempts and every real observation stay visible. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Status}" Value="Queued"/>
                                    <Condition Binding="{Binding State}" Value="Queued"/>
                                    <Condition Binding="{Binding Progress}" Value="0"/>
                                    <Condition Binding="{Binding ProgressDetail}" Value=""/>
                                    <Condition Binding="{Binding Speed}" Value=""/>
                                    <Condition Binding="{Binding Downloaded}" Value=""/>
                                    <Condition Binding="{Binding ETA}" Value=""/>
                                    <Condition Binding="{Binding Path}" Value=""/>
                                    <Condition Binding="{Binding RawError}" Value=""/>
                                    <Condition Binding="{Binding Slot}" Value=""/>
                                    <Condition Binding="{Binding TransferredBytes}" Value="0"/>
                                    <Condition Binding="{Binding StageDir}" Value=""/>
                                    <Condition Binding="{Binding RunDir}" Value=""/>
                                    <Condition Binding="{Binding ResumeState}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding OwnedPaths.Count}" Value="0"/>
                                    <Condition Binding="{Binding CleanupPaths.Count}" Value="0"/>
                                    <Condition Binding="{Binding CleanupError}" Value=""/>
                                    <Condition Binding="{Binding PendingRemoval}" Value="False"/>
                                    <Condition Binding="{Binding AttemptFinished}" Value="False"/>
                                    <Condition Binding="{Binding RequeueRequested}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}"
                             Background="{DynamicResource FieldHoverBrush}" Foreground="{DynamicResource ProgressBrush}" BorderThickness="0"/>
                <WrapPanel Margin="0,3,0,0">
                    <TextBlock Text="{Binding Progress, StringFormat={}{0:F1}%}" Style="{StaticResource GridTextStyle}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Speed, Converter={StaticResource DisplayValueConverter}}" Style="{StaticResource TransferDetailTextStyle}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ETA}" Style="{StaticResource TransferDetailTextStyle}" ToolTip="Осталось времени"/>
                </WrapPanel>
                <TextBlock Text="{Binding Downloaded, Converter={StaticResource DisplayValueConverter}}" Style="{StaticResource TransferDetailTextStyle}" FontSize="11"/>
            </StackPanel>
        </DataTemplate>
      </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowLayoutRoot" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Video Downloader" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Скачивайте видео и аудио в выбранную папку" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderStats" Text="0 активных · 0 МБ/с · 0/0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border Background="{DynamicResource FieldBrush}" CornerRadius="14" Padding="14,7">
                    <TextBlock x:Name="HeaderStatus" Text="● Готово" Foreground="{DynamicResource MutedBrush}"/>
                </Border>
            </StackPanel>
        </Grid>

        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel x:Name="CompactNavigation" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="ShowQueuePanelButton" Content="Очередь" AutomationProperties.Name="Показать очередь"/>
                <Button x:Name="ShowDownloadsPanelButton" Content="Загрузки" AutomationProperties.Name="Показать загрузки"/>
                <Button x:Name="ShowDetailsPanelButton" Content="Видео и параметры" AutomationProperties.Name="Показать выбранное видео и параметры очереди"/>
            </StackPanel>
            <Button x:Name="ToggleDetailsPanelButton" Content="Скрыть правую панель" ToolTip="Показать или скрыть выбранное видео и параметры очереди"/>
            <Button x:Name="OpenQueueOptionsButton" Content="Папка и качество…" ToolTip="Общие параметры следующего запуска"/>
        </WrapPanel>
        <Grid x:Name="MainPanelsGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QueuePanelColumn" Width="506.6666666666667" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="DownloadsPanelColumn" Width="*" MinWidth="300"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="PreviewPanelColumn" Width="390" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="QueuePanel" Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="Очередь" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                        <Button x:Name="ToggleQueueFiltersButton" DockPanel.Dock="Right" Margin="8,0,0,4"
                                Padding="6,3" MinWidth="30" AutomationProperties.Name="Показать поиск и фильтры очереди"
                                ToolTip="Показать поиск и фильтры очереди · Ctrl+F">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QueueActiveFiltersBadge" Margin="5,0,0,0" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="QueueCount" Text="0 ссылок" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,0,0,6">
                        <Border x:Name="ReadinessCard" Background="{DynamicResource FieldBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock x:Name="ReadinessText" Text="Проверяем готовность к скачиванию…" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button x:Name="ReadinessInstallButton" Content="Установить FFmpeg" Padding="8,3" Visibility="Collapsed"/>
                                    <Button x:Name="ReadinessRefreshButton" Content="Проверить ещё раз" Padding="8,3" Visibility="Collapsed"/>
                                </WrapPanel>
                                <ProgressBar x:Name="DependencyProgress" Height="5" Margin="0,5,0,3" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                <TextBlock x:Name="DependencyProgressText" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <Button x:Name="CancelDependencyButton" Content="Отменить" HorizontalAlignment="Left" Padding="8,3" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlInput" AutomationProperties.Name="Ссылка на видео или аудио" Grid.Column="0"
                                 MinHeight="34" MaxHeight="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled" ToolTip="Вставьте одну или несколько ссылок, в том числе во время скачивания"/>
                        <Button x:Name="PasteClipboardButton" Grid.Column="1" Content="Вставить" ToolTip="Добавить ссылки из буфера обмена, в том числе во время скачивания"/>
                        <Button x:Name="AddUrlButton" Grid.Column="2" Content="+ Добавить" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}"/>
                      </Grid>
                      <TextBlock x:Name="InputFeedbackText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{DynamicResource InterruptedStateBrush}" Margin="3,3,3,0"/>
                    </StackPanel>

                    <Expander x:Name="QueueMoreActionsExpander" Grid.Row="3" IsExpanded="False" Margin="0,0,0,6">
                      <Expander.Header><WrapPanel>
                        <TextBlock Text="Ещё" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Button x:Name="ForgetQueueButton" Content="Убрать из очереди" Padding="8,4"/>
                        <Button x:Name="SubscriptionsButton" Content="Подписки" Padding="8,4" ToolTip="Проверки каналов и плейлистов, расписание, новые материалы и исходный набор"/>
                      </WrapPanel></Expander.Header>
                       <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><StackPanel><WrapPanel>
                        <Button x:Name="OpenListButton" Content="Открыть список"/>
                        <Button x:Name="PortableQueueButton" Content="Перенос очереди" ToolTip="Скопировать очередь или сохранить её для другого клиента Windows / Android"/>
                        <Button x:Name="RemoveQueueButton" Content="Удалить загрузки и файлы…"/>
                        <Button x:Name="ClearAllQueueButton" Content="Очистить очередь…"/>
                        <Button x:Name="SkipQueueItemsButton" Content="Пропустить выбранные" IsEnabled="False"/>
                        <Button x:Name="ResumeQueueItemsButton" Content="Продолжить выбранные" IsEnabled="False"/>
                        <Button x:Name="ResetQueueItemsButton" Content="Сбросить и скачать заново…" IsEnabled="False"/>
                        <Button x:Name="QueueDiagnosticsButton" Content="Диагностика…" IsEnabled="False"
                                ToolTip="События, попытки и диагностический пакет одной выбранной строки"/>
                        <Button x:Name="ClearQueueButton" Content="Убрать завершённые"/>
                        <Button x:Name="MoveUpButton" AutomationProperties.Name="Поднять выбранную строку" Content="↑"/>
                        <Button x:Name="MoveDownButton" AutomationProperties.Name="Опустить выбранную строку" Content="↓"/>
                        <Button x:Name="RetryFailedButton" Content="Повторить ошибки" Background="{DynamicResource WarnBrush}" Foreground="{DynamicResource OnWarnBrush}" IsEnabled="False"/>
                        <Button x:Name="OpenOutputDirectoryButton" Content="📂 Открыть папку загрузок" ToolTip="Открыть настроенную папку назначения в Проводнике"/>
                       </WrapPanel>
                        <CheckBox x:Name="ShowVideoTitlesCheck" Content="Показывать названия видео вместо URL" IsChecked="True" ToolTip="URL остаётся доступен второй строкой, в подсказке и меню строки."/>
                        <CheckBox x:Name="WatchClipboardCheck" Content="Следить за буфером обмена и добавлять ссылки"/>
                        <TextBlock x:Name="MainSubscriptionScheduleStatusText" Text="Проверки по расписанию выключены."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                       </StackPanel></ScrollViewer>
                    </Expander>

                    <StackPanel Grid.Row="4" Margin="0,0,0,6">
                        <StackPanel x:Name="QueueFilterPanel" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,4">
                            <Button x:Name="ResetQueueFiltersButton" Content="Сбросить фильтры" DockPanel.Dock="Right" Padding="7,3"/>
                            <TextBlock Text="Поиск в очереди" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                        </DockPanel>
                        <TextBox x:Name="QueueSearchBox" MaxLength="2048" Margin="0,0,0,5"
                                 AutomationProperties.Name="Поиск по названию или URL"
                                 ToolTip="Поиск по названию или части URL без изменения очереди. Ctrl+F — перейти к поиску; Esc — сбросить фильтры."/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="QueueStatusFilter" Margin="0,0,3,0" MinWidth="100"
                                      AutomationProperties.Name="Статус очереди" ToolTip="Фильтр отображаемых строк по статусу"/>
                            <ComboBox x:Name="QueueSubscriptionFilter" Grid.Column="1" Margin="3,0,0,0" MinWidth="120"
                                      AutomationProperties.Name="Подписка очереди" ToolTip="Фильтр по подписке, закреплённой за заданием"/>
                        </Grid>
                        <TextBlock x:Name="QueueFilterScopeHint" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="5">
                    <DataGrid x:Name="QueueGrid" AutomationProperties.Name="Очередь загрузок" AllowDrop="True" Tag="{Binding IsChecked, ElementName=ShowVideoTitlesCheck}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="38" ElementStyle="{StaticResource GridTextStyle}"/>
                            <DataGridTemplateColumn Header="Видео / прогресс" Width="*" MinWidth="185">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Style="{StaticResource VideoLabelStyle}"/>
                                            <TextBlock Style="{StaticResource SecondaryVideoUrlStyle}"/>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TransferDetails}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding StateLabel}" Width="90" ElementStyle="{StaticResource QueueStatusTextStyle}"/>
                            <DataGridTextColumn Header="Подписка / папка" Binding="{Binding SubscriptionName}" Width="120" ElementStyle="{StaticResource GridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="QueueEmptyState" Text="Вставьте ссылку на видео или аудио, затем нажмите «Добавить»." Margin="18" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
                    <TextBlock x:Name="QueueEmptyFilterHint" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="18" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                               IsHitTestVisible="False"/>
                    </Grid>

                    <TextBlock Grid.Row="6" x:Name="ClipboardHint" Text="Добавляйте ссылки вручную, из буфера или перетаскиванием." MaxHeight="30" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
                </Grid>
            </Border>

            <GridSplitter x:Name="QueueDownloadsSplitter" AutomationProperties.Name="Ширина очереди и загрузок" Grid.Column="1" Width="8"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          Background="{DynamicResource BorderBrush}" Cursor="SizeWE" Focusable="True"
                          ToolTip="Перетащите, чтобы изменить ширину очереди и загрузок"/>

            <Border x:Name="DownloadsPanel" Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button x:Name="DownloadDiagnosticsButton" Content="Диагностика…" DockPanel.Dock="Right" Margin="8,0,0,6"
                                IsEnabled="False" ToolTip="Диагностика выбранной загрузки, включая работающую"/>
                        <Button x:Name="OpenHistoryButton" Content="История…" DockPanel.Dock="Right" Margin="8,0,0,6"
                                ToolTip="Найти подтверждённые загрузки и проверить сохранённые файлы"/>
                        <TextBlock Text="Загрузки" Style="{StaticResource SectionTitle}"/>
                    </DockPanel>

                    <DataGrid x:Name="DownloadGrid" AutomationProperties.Name="Загрузки текущего сеанса" Grid.Row="1" SelectionMode="Extended" Tag="{Binding IsChecked, ElementName=ShowVideoTitlesCheck}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Поток" Binding="{Binding Slot}" Width="52" ElementStyle="{StaticResource GridTextStyle}"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding StateLabel}" Width="110" ElementStyle="{StaticResource DownloadStatusTextStyle}"/>
                            <DataGridTextColumn Header="Подписка / папка" Binding="{Binding SubscriptionName}" Width="120" ElementStyle="{StaticResource GridTextStyle}"/>
                            <DataGridTemplateColumn Header="Видео / прогресс" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4">
                                            <TextBlock Style="{StaticResource VideoLabelStyle}"/>
                                            <TextBlock Style="{StaticResource SecondaryVideoUrlStyle}"/>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TransferDetails}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="2" Margin="0,9,0,9">
                        <Button x:Name="OpenFileButton" Content="Открыть файл"/>
                        <Button x:Name="OpenFolderButton" Content="Показать в папке"/>
                        <Button x:Name="CopyPathButton" Content="Копировать путь"/>
                        <Button x:Name="OpenUrlButton" Content="Открыть ссылку"/>
                    </WrapPanel>

                    <Expander x:Name="JournalExpander" Grid.Row="3" Header="Журнал и диагностика" IsExpanded="False">
                     <Grid Height="220" MaxHeight="220">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,0,0,4" VerticalAlignment="Center">
                            <TextBlock Text="Журнал" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <ComboBox x:Name="LogProfileCombo" AutomationProperties.Name="Подробность журнала" Width="190" Margin="0,0,6,4"
                                      ToolTip="Подробность новых событий журнала; можно менять во время скачивания."/>
                            <Button x:Name="CopyJournalButton" Content="Копировать журнал"/>
                            <Button x:Name="SaveJournalButton" Content="Сохранить журнал…"/>
                            <Button x:Name="ClearJournalButton" Content="Очистить"
                                    ToolTip="Очистить экран и копируемый буфер. Файлы журнала сохраняются."/>
                        </WrapPanel>
                        <TextBlock x:Name="JournalHint" Grid.Row="1" Margin="0,0,0,6"
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        <TextBox
                            x:Name="LogBox" AutomationProperties.Name="Журнал приложения"
                            Grid.Row="2"
                            IsReadOnly="True"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            FontFamily="Cascadia Mono"
                            FontSize="12"
                            Background="{DynamicResource MediaSurfaceBrush}"/>
                     </Grid>
                    </Expander>
                </Grid>
            </Border>

            <GridSplitter x:Name="DownloadsPreviewSplitter" AutomationProperties.Name="Ширина загрузок и правой панели" Grid.Column="3" Width="8"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"
                          Background="{DynamicResource BorderBrush}" Cursor="SizeWE" Focusable="True"
                          ToolTip="Перетащите, чтобы изменить ширину загрузок и предпросмотра"/>

            <Border x:Name="PreviewPanel" Grid.Column="4" Style="{StaticResource Panel}">
                <TabControl x:Name="DetailsTabs" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource WindowTextBrush}">
                    <TabItem x:Name="SelectedVideoTab" Header="Видео">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0"><StackPanel>
                        <TextBlock Text="Предпросмотр" Style="{StaticResource SectionTitle}"/>

                        <Border x:Name="PreviewImageHost" Height="190" Background="{DynamicResource MediaSurfaceBrush}" CornerRadius="12" Visibility="Collapsed">
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        </Border>
                        <Grid x:Name="PreviewGalleryNavigation" Margin="0,6,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviewPreviousButton" AutomationProperties.Name="Предыдущее превью" Content="◀" Padding="10,4" IsEnabled="False"
                                    ToolTip="Предыдущее превью"/>
                            <TextBlock x:Name="PreviewImageCounter" Grid.Column="1" Text="0 / 0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            <Button x:Name="PreviewNextButton" AutomationProperties.Name="Следующее превью" Grid.Column="2" Content="▶" Padding="10,4" IsEnabled="False"
                                    ToolTip="Следующее превью"/>
                        </Grid>
                        <TextBlock x:Name="PreviewGalleryHint" Text="Наведите мышь для листания · колесо — вручную" Style="{StaticResource MutedText}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="PreviewTitle" Text="Выберите видео в очереди или загрузках" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,3" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PreviewMeta" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewFormats" Text="" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,12" TextWrapping="Wrap"/>

                        <Button x:Name="MediaSelectionButton" Content="Формат и фрагмент…" IsEnabled="False" Style="{StaticResource GuardedActionButton}"
                                HorizontalContentAlignment="Left"
                                ToolTip="Выбрать точные форматы и интервал для одной строки очереди. Скачивание запускается отдельно."/>
                        <TextBlock x:Name="MediaSelectionSummary" Text="Выберите одну строку очереди."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="3,2,3,10"/>

                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="QueueOptionsTab" Header="Очередь" ToolTip="Общие параметры следующего запуска">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0"><StackPanel>
                            <TextBlock Text="Параметры очереди" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="QueueOptionsScopeHint" Text="Общие параметры следующего запуска. Параметры отдельного видео задаются на вкладке «Видео»."
                                       TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                        <TextBlock Text="Папка загрузок" Style="{StaticResource MutedText}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox" AutomationProperties.Name="Папка загрузок"/>
                            <Button x:Name="PickOutputButton" AutomationProperties.Name="Выбрать папку загрузок" Grid.Column="1" Content="…"/>
                        </Grid>
                        <TextBlock x:Name="DiskSpaceSummaryText" Text="Проверяем свободное место…" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <TextBlock x:Name="DiskSpaceWarningText" Foreground="{DynamicResource WarnBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

                        <TextBlock Text="Профиль" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <ComboBox x:Name="ProfileCombo" AutomationProperties.Name="Профиль загрузки" Margin="0,0,0,9"/>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Аудиодорожка" Style="{StaticResource MutedText}"/>
                            <ComboBox x:Name="AudioTrackCombo" AutomationProperties.Name="Аудиодорожка"/>
                            <TextBlock Text="Языки аудио" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                            <TextBox x:Name="AudioLanguagesBox" Text="ru" IsEnabled="False"
                                     AutomationProperties.Name="Языки аудио"
                                     ToolTip="Коды через запятую: ru, en, pt-BR. Несколько языков — контейнер Авто или MKV, без MP3."/>
                            <TextBlock Text="«Оригинальная» требует отметки источника. «По языкам»: ru или ru,en. Несколько языков сохраняются в MKV; MP3 — один язык. Недоступная дорожка даст ошибку."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Качество" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="QualityCombo" AutomationProperties.Name="Качество видео"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Кодек" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="CodecCombo" AutomationProperties.Name="Предпочтительный кодек"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Контейнер" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="ContainerCombo" AutomationProperties.Name="Контейнер файла"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Ограничение скорости" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="RateLimitCombo" AutomationProperties.Name="Ограничение скорости" IsEditable="True"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Параллельные загрузки" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="ThreadsBox" AutomationProperties.Name="Параллельные загрузки" Text="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Фрагменты" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="FragmentsCombo" AutomationProperties.Name="Параллельные фрагменты"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel>
                            <Button x:Name="FilenameTemplateHelpButton" Content="Справка…" DockPanel.Dock="Right"
                                    Padding="8,3" ToolTip="Поля, примеры и ограничения шаблона имени файла"/>
                            <TextBlock x:Name="FilenameTemplateLabel" Text="Шаблон имени файла" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox x:Name="FilenameTemplateBox" AutomationProperties.Name="Шаблон имени файла" Text="%(title)s [%(id)s].%(ext)s" Margin="0,0,0,8"/>

                        <Expander Header="Субтитры" IsExpanded="False" Margin="0,4">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="WriteSubsCheck" Content="Скачать субтитры"/>
                                <CheckBox x:Name="AutoSubsCheck" Content="Включить автоматические субтитры"/>
                                <CheckBox x:Name="EmbedSubsCheck" Content="Встроить субтитры в медиафайл"/>
                                <TextBlock Text="Языки" Style="{StaticResource MutedText}" Margin="3,4,0,2"/>
                                <TextBox x:Name="SubtitleLangsBox" AutomationProperties.Name="Языки субтитров" Text="ru.*,en.*"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Метаданные" IsExpanded="False" Margin="0,4">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="EmbedThumbnailCheck" Content="Встроить обложку"/>
                                <CheckBox x:Name="EmbedMetadataCheck" Content="Встроить метаданные" IsChecked="True"/>
                                <CheckBox x:Name="EmbedChaptersCheck" Content="Встроить главы" IsChecked="True"/>
                            </StackPanel>
                        </Expander>

                        <WrapPanel Margin="0,5,0,8">
                            <CheckBox x:Name="ArchiveCheck" Content="Архив по дате"/>
                            <CheckBox x:Name="SponsorCheck" Content="SponsorBlock"/>
                            <CheckBox x:Name="AudioOnlyCheck" Content="Только MP3"/>
                        </WrapPanel>

                        <TextBlock Text="Файл cookies" Style="{StaticResource MutedText}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CookiesBox" AutomationProperties.Name="Файл cookies"/>
                            <Button x:Name="PickCookiesButton" AutomationProperties.Name="Выбрать файл cookies" Grid.Column="1" Content="…"/>
                        </Grid>

                        </StackPanel></ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="MaintenanceTab" Header="Настройки">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,0"><StackPanel>
                            <TextBlock Text="Настройки приложения" Style="{StaticResource SectionTitle}"/>
                        <Expander Header="Компоненты" IsExpanded="False" Margin="0,6,0,0">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="DependencyStatus" Text="Проверка…" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <WrapPanel Margin="0,7,0,0">
                                    <Button x:Name="RefreshDepsButton" Content="Проверить"/>
                                    <Button x:Name="InstallFfmpegButton" Content="Установить FFmpeg"/>
                                    <Button x:Name="UpdateYtDlpButton" Content="Обновить yt-dlp"/>
                                    <Button x:Name="RegisterProtocolButton" Content="Зарегистрировать протокол"/>
                                    <Button x:Name="OpenAppSettingsButton" Content="📁 Открыть папку настроек" ToolTip="Открыть %LOCALAPPDATA%\VideoDownloader в Проводнике"/>
                                    <Button x:Name="OpenProfileBackupButton" Content="Резервная копия…" ToolTip="Настройки, подписки и история Windows без cookies, локальных путей и файлов загрузок"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Обновление приложения" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="CurrentAppVersionText" Text="Текущая версия: —"
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="AppUpdateStatusText" Text="Проверка доступна вручную."
                                           TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <WrapPanel Margin="0,7,0,0">
                                    <Button x:Name="CheckAppUpdateButton" Content="Проверить обновление" Style="{StaticResource GuardedActionButton}"/>
                                    <Button x:Name="InstallAppUpdateButton" Content="Обновить и перезапустить" IsEnabled="False" Style="{StaticResource GuardedActionButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                        </StackPanel></ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock x:Name="SessionStats" Text="Сеанс: ожидание" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <ProgressBar x:Name="OverallProgress" AutomationProperties.Name="Общий прогресс загрузки" Height="8" Minimum="0" Maximum="100" Visibility="Hidden"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="TrayButton" Content="В трей" HorizontalAlignment="Left"/>
                <Button x:Name="PauseButton" Grid.Column="1" Content="Пауза" IsEnabled="False" Visibility="Hidden" Background="{DynamicResource WarnBrush}" Foreground="{DynamicResource OnWarnBrush}"/>
                <Button x:Name="StopButton" Grid.Column="2" Content="Остановить" IsEnabled="False" Visibility="Hidden" Background="{DynamicResource DangerBrush}" Foreground="{DynamicResource OnDangerBrush}"/>
                <Button x:Name="StartButton" Grid.Column="3" Content="Скачать всю очередь" IsEnabled="False" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" Padding="18,9"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
