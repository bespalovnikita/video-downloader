<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подписки" Width="1200" Height="800" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource WindowTextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource FieldHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" BorderBrush="Transparent" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Margin" Value="0,8,0,5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AlternateRowBrush}"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="8,7"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="MaxWidth" Value="620"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="0"/>
            <ColumnDefinition x:Name="SubscriptionDetailsGapColumn" Width="12"/>
            <ColumnDefinition x:Name="SubscriptionDetailsColumn" Width="320" MinWidth="0" MaxWidth="480"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="SubscriptionMainScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="SubscriptionMainPanel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="80"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <CheckBox x:Name="SubscriptionPreviewToggle" DockPanel.Dock="Right" Content="Информация о видео"
                      AutomationProperties.Name="Показывать информацию о выбранном видео" IsChecked="True"
                      ToolTip="Показать или скрыть боковую панель в широком окне."/>
            <Button x:Name="OpenSubscriptionDetailsButton" DockPanel.Dock="Right" Content="Информация о видео"
                    AutomationProperties.Name="Открыть информацию о выбранном видео" Visibility="Collapsed" IsEnabled="False"
                    ToolTip="Показать выбранный материал и его превью на всю ширину окна."/>
            <TextBlock Text="Подписки" FontSize="24" FontWeight="SemiBold"/>
        </DockPanel>
        <Expander Grid.Row="1" x:Name="AddSubscriptionExpander" Header="Добавить подписку" IsExpanded="False" Margin="0,0,0,8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="12" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="URL канала или плейлиста, имя файла или ID видео Pornhub" Margin="0,0,10,5" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="RSS / Atom (необязательно)" Margin="0,0,10,5"/>
                <TextBox Grid.Row="1" x:Name="SubscriptionUrlBox" Margin="0,0,10,0"
                         AutomationProperties.Name="URL канала, имя файла или ID видео Pornhub"
                         ToolTip="Чтобы найти модель Pornhub, вставьте ссылку на видео, его ID или имя скачанного файла с ID в квадратных скобках."/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SubscriptionFeedBox" Margin="0,0,10,0"
                         ToolTip="Лента дополняет полную проверку через yt-dlp. Для YouTube лента может определиться автоматически."/>
                <Button Grid.Row="1" Grid.Column="2" x:Name="AddSubscriptionButton" Content="Добавить и проверить" Tag="Primary" Margin="0"/>
                <StackPanel x:Name="PornHubProfilesPanel" Grid.Row="2" Grid.ColumnSpan="3" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="Профиль модели Pornhub" Margin="0,0,0,5"/>
                    <ComboBox x:Name="PornHubProfilesCombo" AutomationProperties.Name="Профиль модели Pornhub"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Краткое имя / папка (необязательно)" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="NewSubscriptionNameBox" Width="300" MaxLength="160"
                             ToolTip="Оставьте пустым, чтобы взять имя канала или плейлиста при первой проверке. Можно задать своё, например 123."/>
                </StackPanel>
                <ComboBox Grid.Row="4" Grid.ColumnSpan="3" x:Name="SubscriptionInitialActionCombo" SelectedIndex="1" Margin="0,8,0,5"
                          AutomationProperties.Name="Действие с существующими материалами"
                          ToolTip="Действие применяется к материалам первой успешной полной проверки. Последующие новинки появятся со статусом «Новое».">
                    <ComboBox.Resources>
                        <DataTemplate x:Key="InitialActionTemplate"><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="600"/></DataTemplate>
                    </ComboBox.Resources>
                    <ComboBoxItem Tag="Queue" Content="Добавить все материалы в текущую очередь скачивания" ContentTemplate="{StaticResource InitialActionTemplate}"/>
                    <ComboBoxItem Tag="Skip" Content="Добавить все материалы в подписку без скачивания в статусе &quot;пропущено&quot;" ContentTemplate="{StaticResource InitialActionTemplate}"/>
                    <ComboBoxItem Tag="ManualDone" Content="Добавить все материалы в подписку без скачивания в статусе &quot;готово&quot;" ContentTemplate="{StaticResource InitialActionTemplate}"/>
                </ComboBox>
                <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                           Text="Первая полная проверка начнётся сразу. «Пропущено» и ручная отметка «Готово» сохраняют список без скачивания; «Готово» не означает наличие файла. При добавлении в очередь повтор уже скачанных URL потребует подтверждения. Скачивание запускается отдельно кнопкой «Скачать всю очередь»."/>
            </Grid>
        </Border>
        </ScrollViewer>
        </Expander>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="CheckSubscriptionButton" Content="Проверить"/>
                <Button x:Name="CheckAllSubscriptionsButton" Content="Проверить все"/>
                <CheckBox x:Name="FullSubscriptionCheck" IsChecked="False" Content="Полная проверка" Margin="4,0,12,0" VerticalAlignment="Center"
                          ToolTip="Повторно обойти всю коллекцию. Без флажка поддерживаемые каналы сначала проверяют 20 новых материалов; остальные источники обходятся полностью."/>
                <Button x:Name="CancelSubscriptionCheckButton" Content="Отменить проверку" IsEnabled="False"/>
                <Button x:Name="PauseSubscriptionButton" Content="Приостановить"/>
                <Button x:Name="RemoveSubscriptionButton" Content="Удалить подписку"/>
            </WrapPanel>
            <Expander x:Name="SubscriptionEditorExpander" Header="Настройки выбранной подписки" IsExpanded="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
            <StackPanel Margin="0,5,0,5">
            <WrapPanel>
                <TextBlock Text="Краткое имя выбранной подписки / папка" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="SubscriptionNameBox" Width="260" MaxLength="160" Margin="0,0,10,0"
                         AutomationProperties.Name="Краткое имя и папка выбранной подписки"/>
                <Button x:Name="SaveSubscriptionNameButton" Content="Сохранить имя"/>
            </WrapPanel>
            <TextBlock Text="Материалы сохраняются в подпапку с этим именем, например D:\Video\123. Изменение имени действует на новые задания."
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
            <WrapPanel Margin="0,8,0,0">
                <CheckBox x:Name="SubscriptionScheduleEnabledCheck" Content="Проверять по расписанию" Margin="0,0,12,0" VerticalAlignment="Center"
                          ToolTip="Только пока приложение открыто или в трее. Первая проверка источника выполняется вручную; расписание не добавляет материалы в очередь и не скачивает их."/>
                <TextBlock Text="Каждые" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SubscriptionScheduleIntervalBox" Text="30" Width="70" MaxLength="5" Margin="0,0,8,0"
                         ToolTip="От 5 до 10080 минут. После запуска приложения или включения расписания сначала проходит полный интервал."/>
                <TextBlock Text="минут" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="SaveSubscriptionScheduleButton" Content="Сохранить расписание"/>
            </WrapPanel>
            <TextBlock x:Name="SubscriptionScheduleStatusText" Text="Проверки по расписанию выключены."
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="URL подписки" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="SelectedSubscriptionUrlBox" IsReadOnly="True" Margin="0,0,10,0"
                         AutomationProperties.Name="Полный исходный URL выбранной подписки"
                         ToolTip="Исходный адрес выбранной подписки. Можно выделить текст и нажать Ctrl+C."/>
                <Button Grid.Column="2" x:Name="CopySubscriptionUrlButton" Content="Копировать URL" Margin="0" IsEnabled="False"/>
            </Grid>
            <StackPanel DataContext="{Binding SelectedItem, ElementName=SubscriptionGrid}" Margin="0,8,0,0">
                <TextBlock x:Name="SubscriptionLastAttemptText" Text="{Binding LastAttemptLabel, StringFormat='Последняя попытка: {0}'}"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="SubscriptionLastSuccessText" Text="{Binding LastSuccessLabel, StringFormat='Успешная проверка: {0}'}"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="SubscriptionNextCheckText" Text="{Binding NextCheckLabel, StringFormat='Следующая проверка: {0}'}"
                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            </StackPanel>
            </ScrollViewer>
            </Expander>
            <Border x:Name="SubscriptionCheckProgressPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource SelectionBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="SubscriptionCheckSourceText" Text="Проверка подписок" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                    <TextBlock Grid.Column="1" x:Name="SubscriptionCheckCountText" Text="Проверено: 0 / 0"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,18,0"/>
                    <TextBlock Grid.Column="2" x:Name="SubscriptionCheckElapsedText" Text="Прошло: 00:00" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Grid.Row="1" x:Name="SubscriptionCheckStageText" Text="Подготовка…"
                               Foreground="{DynamicResource ActiveStateBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,14,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SubscriptionCheckDetailText"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" x:Name="SubscriptionCheckOverallProgress"
                                 Minimum="0" Maximum="1" Value="0" Height="6" Margin="0,7,0,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource FieldHoverBrush}" BorderThickness="0"
                                 ToolTip="Количество завершённых проверок источников"/>
                    <ProgressBar Grid.Row="3" Grid.ColumnSpan="3" x:Name="SubscriptionCheckActivityProgress"
                                 IsIndeterminate="False" Height="3" Margin="0,3,0,0"
                                 Foreground="{DynamicResource ProgressBrush}" Background="{DynamicResource FieldHoverBrush}" BorderThickness="0"
                                 ToolTip="Работа с текущим источником"/>
                </Grid>
            </Border>
        </StackPanel>
        <DataGrid Grid.Row="3" x:Name="SubscriptionGrid" SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip">
                        <Setter.Value><ToolTip><TextBlock Text="{Binding DiagnosticDetails}" TextWrapping="Wrap" MaxWidth="600"/></ToolTip></Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Подписка" SortMemberPath="Title" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                                <TextBlock x:Name="SubscriptionSourceIdentity" Text="{Binding Url}" FontSize="11"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"
                                           AutomationProperties.Name="{Binding Url}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Состояние" Binding="{Binding StatusLabel}" Width="145"/>
                <DataGridTextColumn Header="Расписание" Binding="{Binding ScheduleLabel}" Width="125"/>
                <DataGridTextColumn Header="Ошибка / предупреждение" Binding="{Binding Message}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding DiagnosticDetails}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="{DynamicResource BorderBrush}"/>
        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,5">
                <TextBlock x:Name="SubscriptionInboxCountText" DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="SubscriptionInboxTitle" Text="Входящие и результаты" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock Text="Поиск по названию или URL" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SubscriptionInboxSearchBox" MaxLength="2048" Margin="0,0,8,0"
                         AutomationProperties.Name="Поиск материалов подписки по названию или URL" ToolTip="Ctrl+F — поиск. Esc — сбросить поиск и фильтр состояния."/>
                <ComboBox Grid.Column="1" x:Name="SubscriptionInboxStateFilter" SelectedValuePath="Key" DisplayMemberPath="Label" Margin="0,0,8,0"
                          AutomationProperties.Name="Состояние материалов подписки"
                          ToolTip="«Обработанные» — подтверждённые успешные загрузки, включая другую подписку. Ручная отметка «Готово» остаётся в «Все»."/>
                <Button Grid.Column="2" x:Name="ResetSubscriptionInboxFiltersButton" Content="Сбросить" Margin="0"/>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="6">
        <DataGrid x:Name="SubscriptionInboxGrid" SelectionMode="Extended" CanUserSortColumns="False"
                  ToolTip="Порядок материалов соответствует последней проверке источника. Ранее обнаруженные материалы, отсутствующие в текущем результате, сохранены в конце списка. Для обновления порядка старого снимка выполните полную проверку.">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding Url}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Материал" Binding="{Binding Title}" Width="3*"/>
                <DataGridTextColumn Header="Состояние" Binding="{Binding StateLabel}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding StateDescription}"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Обнаружен" Binding="{Binding DiscoveredLabel}" Width="145"/>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="SubscriptionInboxEmptyText" Visibility="Collapsed" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                   IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
        </Grid>
        <WrapPanel Grid.Row="7" Margin="0,10,0,8">
            <Button x:Name="QueueSubscriptionItemsButton" Content="Добавить выбранные в очередь" Tag="Primary"
                    ToolTip="Только выделенные видимые материалы. Скачивание запускается отдельно кнопкой «Скачать всю очередь»."/>
            <Button x:Name="SkipSubscriptionItemsButton" Content="Пропустить"/>
            <Button x:Name="OpenSubscriptionItemButton" Content="Открыть URL"/>
        </WrapPanel>
        <StackPanel Grid.Row="8">
            <TextBlock x:Name="SubscriptionStatusText" Text="Выделите материалы и добавьте их в очередь. Скачивание запускается отдельно кнопкой «Скачать всю очередь»."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>
        </Grid>
        </ScrollViewer>
        <GridSplitter x:Name="SubscriptionDetailsSplitter" Grid.Column="1" Width="4"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      ToolTip="Изменить ширину списка и информации о видео"/>
        <Border x:Name="SubscriptionDetailsPanel" Grid.Column="2" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button x:Name="BackToSubscriptionsListButton" Content="← К списку подписок" Visibility="Collapsed"
                            HorizontalAlignment="Left" Margin="0,0,0,12"
                            AutomationProperties.Name="Вернуться к списку подписок и материалов"/>
                    <TextBlock Text="Информация о видео" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="SubscriptionPreviewTitle" Text="Видео не выбрано" FontSize="16"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SubscriptionPreviewStatus" Text="Выберите один материал в списке слева."
                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <Image x:Name="SubscriptionPreviewImage" Stretch="Uniform" MaxHeight="220"
                           HorizontalAlignment="Stretch" Margin="0,12,0,0" Visibility="Collapsed"/>
                    <Image x:Name="SubscriptionPreviewSecondImage" Stretch="Uniform" MaxHeight="220"
                           HorizontalAlignment="Stretch" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="SubscriptionPreviewInfo" Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <TextBlock x:Name="SubscriptionPreviewError" Foreground="{DynamicResource ValidationBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="Collapsed"
                               ToolTip="Диагностика получения метаданных или обложки выбранного видео."/>
                    <TextBlock Text="URL видео" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,16,0,5"/>
                    <TextBox x:Name="SubscriptionPreviewUrlBox" IsReadOnly="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="112" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             ToolTip="Точный адрес выбранного видео. Можно выделить текст и нажать Ctrl+C."/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="SubscriptionOpenVideoButton" Content="Открыть URL" IsEnabled="False" Margin="0,0,7,7"/>
                        <Button x:Name="SubscriptionCopyVideoUrlButton" Content="Копировать URL" IsEnabled="False" Margin="0,0,0,7"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
