<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Уже скачано" Width="730" Height="310" MinWidth="590"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource WindowTextBrush}" FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldHoverBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinWidth" Value="115"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DuplicateButtonChrome" BorderBrush="Transparent" BorderThickness="2"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DuplicateButtonChrome" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DuplicateButtonChrome" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/></Trigger>
                <Trigger Property="Tag" Value="Danger"><Setter Property="Background" Value="{DynamicResource DangerBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="CounterLabel" Grid.Row="0" FontSize="18" FontWeight="Bold"
                   Text="Ссылка уже скачивалась"/>
        <TextBlock Grid.Row="1" Foreground="{DynamicResource TransferTextBrush}" Margin="0,9,0,10" TextWrapping="Wrap"
                   Text="Эта ссылка уже была успешно скачана. Скачать её ещё раз? При выборе «Нет» ссылка удаляется из очереди."/>
        <TextBlock x:Name="CompletedAtLabel" Grid.Row="2" Foreground="{DynamicResource TransferTextBrush}" Margin="0,0,0,10"/>
        <TextBox x:Name="DuplicateUrl" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource WindowTextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                 Padding="10" MinHeight="60" MaxHeight="90"/>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="YesButton" Content="Да" Tag="Primary"/>
            <Button x:Name="NoButton" Content="Нет" Tag="Danger"/>
            <Button x:Name="YesAllButton" Content="Да для всех" Tag="Primary"/>
            <Button x:Name="NoAllButton" Content="Нет для всех" Tag="Danger"/>
            <Button x:Name="CancelButton" Content="Отмена" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
