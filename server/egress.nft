destroy table inet video_downloader

table inet video_downloader {
    set blocked_ipv4 {
        type ipv4_addr
        flags interval
        elements = {
            0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            168.63.129.16, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24,
            192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15,
            198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3
        }
    }

    chain outbound {
        # Match Docker's local DNS address before output DNAT rewrites the port.
        type filter hook output priority -150; policy drop;
        ct state established accept
        ip daddr 127.0.0.11 udp dport 53 accept
        ip daddr 127.0.0.11 tcp dport 53 accept
        ip daddr @blocked_ipv4 drop
        meta nfproto ipv4 meta l4proto tcp accept
    }
}
