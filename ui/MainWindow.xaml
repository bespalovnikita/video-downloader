<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="MainWindow"
    Title="Video Downloader"
    Width="1500"
    Height="900"
    MinWidth="1280"
    MinHeight="760"
    WindowStartupLocation="CenterScreen"
    Background="#111318"
    Foreground="#EEF1F8"
    FontFamily="Segoe UI"
    AllowDrop="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B1E25"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#252932"/>
        <SolidColorBrush x:Key="FieldHoverBrush" Color="#303644"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#949CAE"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="OkBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEF1F8"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EEF1F8"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="#343946"/>
            <Setter Property="CaretBrush" Value="#EEF1F8"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EEF1F8"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource FieldHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2F3A63"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#EEF1F8"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="#343946"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton
                                x:Name="ToggleButton"
                                Focusable="False"
                                ClickMode="Press"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="ComboChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                            <Grid>
                                                <Path
                                                    Width="8"
                                                    Height="5"
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Fill="#C5CBD8"
                                                    Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboChrome" Property="Background" Value="{StaticResource FieldHoverBrush}"/>
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#4B5364"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter
                                x:Name="ContentSite"
                                Margin="9,4,30,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <TextBox
                                x:Name="PART_EditableTextBox"
                                Margin="8,3,30,3"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                Foreground="{TemplateBinding Foreground}"
                                CaretBrush="#EEF1F8"
                                BorderThickness="0"
                                Padding="0"
                                Visibility="Hidden"
                                Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Popup
                                x:Name="PART_Popup"
                                Placement="Bottom"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                PopupAnimation="Fade">
                                <Border
                                    MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                    MaxHeight="300"
                                    Margin="0,3,0,0"
                                    Background="#1B1E25"
                                    BorderBrush="#3B4251"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <ScrollViewer
                                        Margin="1"
                                        CanContentScroll="True"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEF1F8"/>
            <Setter Property="Margin" Value="3,5"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="#EEF1F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#343946"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowBackground" Value="#1B1E25"/>
            <Setter Property="AlternatingRowBackground" Value="#20242D"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111318"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#EEF1F8"/>
            <Setter Property="Background" Value="#1B1E25"/>
            <Setter Property="BorderBrush" Value="#343946"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252B36"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2F3A63"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#EEF1F8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2F3A63"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="#2F3A63"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEF1F8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#EEF1F8"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Video Downloader" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="WPF · yt-dlp · structured progress" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderStats" Text="0 active · 0 MB/s · 0/0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border Background="{StaticResource FieldBrush}" CornerRadius="14" Padding="14,7">
                    <TextBlock x:Name="HeaderStatus" Text="● Ready" Foreground="{StaticResource MutedBrush}"/>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="Queue" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="QueueCount" Text="0 URLs" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UrlInput" Grid.Column="0" ToolTip="Paste one or more URLs"/>
                        <Button x:Name="AddUrlButton" Grid.Column="1" Content="+ Add" Background="{StaticResource AccentBrush}"/>
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                        <Button x:Name="OpenListButton" Content="Open list"/>
                        <Button x:Name="RemoveQueueButton" Content="Remove"/>
                        <Button x:Name="ClearQueueButton" Content="Clear"/>
                        <Button x:Name="MoveUpButton" Content="↑"/>
                        <Button x:Name="MoveDownButton" Content="↓"/>
                        <Button x:Name="RetryFailedButton" Content="↻ Failed" Background="{StaticResource WarnBrush}" IsEnabled="False"/>
                    </WrapPanel>

                    <DataGrid x:Name="QueueGrid" Grid.Row="3" AllowDrop="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="38" ElementStyle="{StaticResource GridTextStyle}"/>
                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" ElementStyle="{StaticResource GridTextStyle}"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <CheckBox x:Name="WatchClipboardCheck" Content="Watch clipboard and auto-add URLs"/>
                        <TextBlock x:Name="ClipboardHint" Text="Drop .txt, .url or links here. Drag rows to reorder." Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="190"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Downloads" Style="{StaticResource SectionTitle}"/>

                    <DataGrid x:Name="DownloadGrid" Grid.Row="1" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="52" ElementStyle="{StaticResource GridTextStyle}"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="185" ElementStyle="{StaticResource GridTextStyle}"/>
                            <DataGridTextColumn Header="Video" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource GridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="2" Margin="0,9,0,9">
                        <Button x:Name="OpenFileButton" Content="Open file"/>
                        <Button x:Name="OpenFolderButton" Content="Show in folder"/>
                        <Button x:Name="CopyPathButton" Content="Copy path"/>
                        <Button x:Name="OpenUrlButton" Content="Open URL"/>
                    </WrapPanel>

                    <TextBox
                        x:Name="LogBox"
                        Grid.Row="3"
                        IsReadOnly="True"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        FontFamily="Cascadia Mono"
                        FontSize="12"
                        Background="#0D0F13"/>
                </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Preview" Style="{StaticResource SectionTitle}"/>

                        <Border Height="190" Background="#0D0F13" CornerRadius="12">
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                        </Border>
                        <TextBlock x:Name="PreviewTitle" Text="Select a queue item" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,3" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PreviewMeta" Text="" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PreviewFormats" Text="" Foreground="#B7C0D8" Margin="0,5,0,12" TextWrapping="Wrap"/>

                        <TextBlock Text="Profile" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <ComboBox x:Name="ProfileCombo" Margin="0,0,0,9"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Quality" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="QualityCombo"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Codec" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="CodecCombo"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Container" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="ContainerCombo"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Rate limit" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="RateLimitCombo" IsEditable="True"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Parallel URLs" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="ThreadsBox" Text="4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Fragments" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="FragmentsCombo"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Filename template" Style="{StaticResource MutedText}"/>
                        <TextBox x:Name="FilenameTemplateBox" Text="%(title)s [%(id)s].%(ext)s" Margin="0,0,0,8"/>

                        <Expander Header="Subtitles" IsExpanded="False" Margin="0,4">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="WriteSubsCheck" Content="Download subtitles"/>
                                <CheckBox x:Name="AutoSubsCheck" Content="Include auto-generated subtitles"/>
                                <CheckBox x:Name="EmbedSubsCheck" Content="Embed subtitles into media"/>
                                <TextBlock Text="Languages" Style="{StaticResource MutedText}" Margin="3,4,0,2"/>
                                <TextBox x:Name="SubtitleLangsBox" Text="ru.*,en.*"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Metadata" IsExpanded="False" Margin="0,4">
                            <StackPanel Margin="8">
                                <CheckBox x:Name="EmbedThumbnailCheck" Content="Embed thumbnail"/>
                                <CheckBox x:Name="EmbedMetadataCheck" Content="Embed metadata" IsChecked="True"/>
                                <CheckBox x:Name="EmbedChaptersCheck" Content="Embed chapters" IsChecked="True"/>
                            </StackPanel>
                        </Expander>

                        <WrapPanel Margin="0,5,0,8">
                            <CheckBox x:Name="ArchiveCheck" Content="Archive by date"/>
                            <CheckBox x:Name="SponsorCheck" Content="SponsorBlock"/>
                            <CheckBox x:Name="AudioOnlyCheck" Content="MP3 only"/>
                        </WrapPanel>

                        <TextBlock Text="Output folder" Style="{StaticResource MutedText}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputBox"/>
                            <Button x:Name="PickOutputButton" Grid.Column="1" Content="…"/>
                        </Grid>

                        <TextBlock Text="Cookies" Style="{StaticResource MutedText}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CookiesBox"/>
                            <Button x:Name="PickCookiesButton" Grid.Column="1" Content="…"/>
                        </Grid>

                        <Expander Header="Dependencies" IsExpanded="True" Margin="0,6,0,0">
                            <StackPanel Margin="8">
                                <TextBlock x:Name="DependencyStatus" Text="Checking..." TextWrapping="Wrap" Foreground="#B7C0D8"/>
                                <WrapPanel Margin="0,7,0,0">
                                    <Button x:Name="RefreshDepsButton" Content="Refresh"/>
                                    <Button x:Name="InstallFfmpegButton" Content="Install FFmpeg"/>
                                    <Button x:Name="UpdateYtDlpButton" Content="Update yt-dlp"/>
                                    <Button x:Name="RegisterProtocolButton" Content="Register protocol"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SessionStats" Text="Session: idle" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                <ProgressBar x:Name="OverallProgress" Height="15" Minimum="0" Maximum="100"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                <Button x:Name="TrayButton" Content="To tray"/>
                <Button x:Name="PauseButton" Content="Pause" IsEnabled="False" Background="{StaticResource WarnBrush}"/>
                <Button x:Name="StopButton" Content="Stop" IsEnabled="False" Background="{StaticResource DangerBrush}"/>
                <Button x:Name="StartButton" Content="▶ Start" IsEnabled="False" Background="{StaticResource AccentBrush}" Padding="18,9"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
